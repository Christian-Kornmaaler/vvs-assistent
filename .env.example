# AI (mindst én af dem)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Valgfrit: tving udbyder og model
AI_PROVIDER=        # anthropic | openai
AI_MODEL=           # fx claude-haiku-5-5

# Magento (uden disse kører assistenten på demo-data)
MAGENTO_URL=https://vvsfittings.dk
MAGENTO_TOKEN=      # Access Token fra en integration med KUN læseadgang til produkter og lager
# Valgfrit: OAuth-signering (så skal Magento ikke tillade "standalone Bearer tokens")
MAGENTO_CONSUMER_KEY=
MAGENTO_CONSUMER_SECRET=
MAGENTO_ACCESS_TOKEN_SECRET=
MAGENTO_STORE_CODE=          # tom = standard-storeview (/rest/V1)
MAGENTO_URL_SUFFIX=.html
MAGENTO_PRICES_INCLUDE_VAT=false   # true hvis katalogpriserne i Magento er inkl. moms

# Domæner der må vise assistenten i en iframe
FRAME_ANCESTORS='self' https://vvsfittings.dk https://*.vvsfittings.dk
